@startuml
' Apply Voucher - Customer
' Compatible with PlantUML 1.2025.2 (no colon syntax)

title Apply Voucher - Customer (During Checkout)

actor Customer
participant CheckoutUI
participant ":CheckoutRouter" as CheckoutRouter
participant ":AuthMiddleware" as AuthMiddleware
participant ":VoucherController" as VoucherController
participant ":VoucherModel" as VoucherModel
database MongoDB

Customer -> CheckoutUI : 1. Enter voucher code in checkout form
activate Customer
activate CheckoutUI

CheckoutUI -> CheckoutRouter : 2. POST /checkout/apply-voucher {code, orderTotal, token}
activate CheckoutRouter

CheckoutRouter -> AuthMiddleware : 2.1 requireAuth(req)
activate AuthMiddleware
AuthMiddleware -> AuthMiddleware : 2.1.1 verify token/session
AuthMiddleware --> CheckoutRouter : 2.1.2 next()
deactivate AuthMiddleware

CheckoutRouter -> VoucherController : 3. applyVoucher(req)
activate VoucherController

VoucherController -> VoucherModel : 3.1 findOne({ code })
activate VoucherModel
VoucherModel -> MongoDB : 3.1.1 query voucher by code
activate MongoDB
MongoDB --> VoucherModel : 3.1.2 voucher doc / null
deactivate MongoDB

alt Voucher not found
  VoucherModel --> VoucherController : 3.2.1 null
  VoucherController --> CheckoutRouter : 3.2.2 404 Not Found
  CheckoutRouter --> CheckoutUI : 3.2.3 Show "Invalid voucher code"
else Voucher found
  VoucherModel --> VoucherController : 3.3.1 voucher doc
  VoucherController -> VoucherController : 3.3.2 check validity (date range, usage limit)

  alt Invalid or expired
    VoucherController --> CheckoutRouter : 3.3.3 400 Invalid voucher
    CheckoutRouter --> CheckoutUI : 3.3.4 Show "Voucher expired or invalid"
  else Valid
    VoucherController -> VoucherController : 3.3.5 verify order meets min value
    alt Order not eligible
      VoucherController --> CheckoutRouter : 3.3.6 400 Not applicable
      CheckoutRouter --> CheckoutUI : 3.3.7 Show "Order value too low"
    else Eligible
      VoucherController -> VoucherController : 3.3.8 calculate discount
      VoucherController --> CheckoutRouter : 3.3.9 200 OK (discounted total)
      CheckoutRouter --> CheckoutUI : 3.3.10 Update order total
    end
  end
end

deactivate VoucherModel
deactivate VoucherController
deactivate CheckoutRouter

CheckoutUI --> Customer : 4. Show updated total & discount
deactivate CheckoutUI
deactivate Customer

note left of CheckoutRouter
Exception cases:
- Invalid token → 401
- DB error → 500
- Voucher expired → 400
- Not applicable → 400
end note

@enduml

