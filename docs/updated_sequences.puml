activate VoucherRoutes

VoucherRoutes -> AuthMiddleware : 3. requireAuth(req)
activate AuthMiddleware
AuthMiddleware -> AuthMiddleware : 4. jwt.verify(token)
activate AuthMiddleware 
deactivate AuthMiddleware 
AuthMiddleware --> VoucherRoutes : 5. attaches req.user, next()
deactivate AuthMiddleware

VoucherRoutes -> AuthMiddleware : 6. requireRole('admin')(req)
activate AuthMiddleware
AuthMiddleware -> AuthMiddleware : 7. check req.user.role
activate AuthMiddleware 
deactivate AuthMiddleware 
AuthMiddleware --> VoucherRoutes : 8. next()
deactivate AuthMiddleware

VoucherRoutes -> VoucherController : 9. createVoucher(req)
activate VoucherController
VoucherController -> VoucherController : 10. validate fields (code,discountPercent,expiryDate,usageLimit)
activate VoucherController
deactivate VoucherController
alt Validation fails
  VoucherController --> VoucherRoutes : 10.1 res.status(400).json({message})
  VoucherRoutes --> VoucherPage: 10.1.1 400 Bad Request
else Validation ok
