title Voucher - List (Admin) - class diagram
class VoucherRoutes {
  +listVouchers(req,res)
  +getVoucher(req,res)
  +createVoucher(req,res)
}
class AuthMiddleware {
  +requireAuth(req,res,next)
  +requireRole(role)(req,res,next)
}
class VoucherController {
  +listVouchers(req,res)
  +buildFilters(query)
  +getVoucher(req,res)
  -- pagination, filters, returns {vouchers,pagination}
}
class VoucherModel << (M,#FFAAAA) >> {
  ' file: server/models/Voucher.js
  -code: String
  -discountPercent: Number
  -expiryDate: Date
  -usageLimit: Number
  -usagePerUser: Number
  -status: String
  +countDocuments(filter)
  +find(filter)
  +findById(id)
  +findOne(filter)
}
database MongoDB

VoucherRoutes --> AuthMiddleware : uses (requireAuth, requireRole)
VoucherRoutes --> VoucherController : calls (listVouchers)
VoucherController --> VoucherModel : calls (countDocuments, find)
VoucherModel --> MongoDB : query list / count
